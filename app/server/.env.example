# Copy this file to .env and fill in real values before running.

# Postgres connection string. Local dev via Docker:
#   docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/sieve
#   (create the `sieve` database once first: `createdb sieve` or via psql)
# Or use a free managed instance (Neon, Railway, Supabase) — they hand you
# this string directly, already includes the database name.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sieve

# Managed Postgres providers require SSL with a cert that doesn't chain
# cleanly to Node's default trust store — the app handles this automatically.
# Set PGSSL=disable only for a local, non-SSL Postgres instance (e.g. the
# Docker command above).
PGSSL=disable

# Random long string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Paystack test keys — free to get, no business verification needed for test mode.
# Sign up at https://dashboard.paystack.com, take these from Settings > API Keys & Webhooks.
# Swap for live (pk_live_ / sk_live_) keys once your business is verified on Paystack.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com) — free tier, signup takes ~2 minutes, no business
# verification needed. Powers password-reset emails, team invites, and "you got
# a new lead" notifications. Leave blank and the app still works — sends are
# just skipped and logged to the console instead.
RESEND_API_KEY=
# Must be "Name <address@yourdomain.com>". Resend's sandbox sender
# (onboarding@resend.dev) only delivers to your own verified Resend account
# email until you verify a real sending domain.
EMAIL_FROM=Sieve <onboarding@resend.dev>

# Used to build links inside emails (password reset, team invites).
# Set this to your real domain once deployed, e.g. https://app.yourdomain.com
APP_URL=http://localhost:5500

# How many days of database backups scripts/backup.js keeps before deleting old ones.
BACKUP_KEEP_DAYS=14

# Optional — a separate Postgres instance/database for `npm test` to use.
# Falls back to DATABASE_URL above if unset (fine for local dev; use a
# genuinely separate instance once this runs in CI against shared infra).
TEST_DATABASE_URL=

# Port the server listens on.
PORT=5500
